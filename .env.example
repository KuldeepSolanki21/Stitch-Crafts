# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stitch_and_crafts_db?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_ACCESS_SECRET="super_secret_access_key_stitch_and_crafts_2026"
JWT_REFRESH_SECRET="super_secret_refresh_key_stitch_and_crafts_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Admin Initial Seed Credentials
ADMIN_NAME="Super Administrator"
ADMIN_EMAIL="admin@stitchandcrafts.com"
ADMIN_PASSWORD="Admin@StitchCrafts2026"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Stripe Payment Gateway
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret_key"

# URLs & Ports
PORT=5000
NODE_ENV=development
API_URL="http://localhost:5000/api/v1"

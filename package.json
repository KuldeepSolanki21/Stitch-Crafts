{
  "name": "stitch-and-crafts",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:migrate": "pnpm --filter @stitch-and-crafts/server db:migrate",
    "db:generate": "pnpm --filter @stitch-and-crafts/server db:generate",
    "db:studio": "pnpm --filter @stitch-and-crafts/server db:studio"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "prettier": "^3.2.5"
  }
}